# PostgreSQL connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=fatec

# Base URL of a running FATEC API instance.
# The /clustering and /ewh_optimization pipelines retrieve previous
# task results through this URL, so it must point at the same service.
API_BASE_URL=http://localhost:8000
